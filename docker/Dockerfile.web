# ===============================================================
# ParkCloud Frontend Web Server Container (Nginx Static + Proxy)
# Multi-stage security-hardened minimal Alpine container
# ===============================================================

FROM nginx:1.27-alpine AS web

# Install tzdata and curl/wget for health checks
RUN apk add --no-cache wget curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && \
    echo "Asia/Kolkata" > /etc/timezone

# Clean default Nginx HTML & conf
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/*

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend distribution assets
COPY app-extracted/dist/index.html /usr/share/nginx/html/index.html
COPY app-extracted/dist/assets /usr/share/nginx/html/assets

# Secure file permissions (read-only for nginx worker)
RUN chmod -R 755 /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Docker native health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/health || exit 1

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
