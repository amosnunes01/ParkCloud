# ===============================================================
# ParkCloud Backend API Container (Node.js REST Service)
# Multi-stage security-hardened minimal Alpine container
# ===============================================================

FROM node:20-alpine AS base

# Install curl/wget for container health checks
RUN apk add --no-cache curl wget ca-certificates tzdata && \
    cp /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && \
    echo "Asia/Kolkata" > /etc/timezone

# Create dedicated non-root application user and group
RUN addgroup -S -g 1001 parkcloud && \
    adduser -S -u 1001 -G parkcloud parkcloud

WORKDIR /opt/parkcloud

# Copy backend server script
COPY --chown=parkcloud:parkcloud app-extracted/dist/mock-api.js /opt/parkcloud/mock-api.js

# Create persistent storage directory for reports and runtime data
RUN mkdir -p /opt/parkcloud/data && \
    chown -R parkcloud:parkcloud /opt/parkcloud

# Switch to unprivileged non-root user
USER parkcloud

# Environment configuration
ENV NODE_ENV=production \
    PORT=5000 \
    TZ=Asia/Kolkata

# Expose internal API service port
EXPOSE 5000

# Docker native health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:5000/api/health || exit 1

# Start Node.js API server
CMD ["node", "mock-api.js"]
